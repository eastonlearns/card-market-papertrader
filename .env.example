# ============================================================================
# GrailBot configuration — copy to `.env` and fill in your OWN credentials.
# GrailBot is fully isolated: its own keys, its own accounts, its own billing.
# Nothing here is shared with any other project.
#
# You can run everything in MOCK mode with NO keys at all:
#     GRAILBOT_MODE=mock
# ============================================================================

# mock  = run against bundled sample data (no network, no keys) — default
# live  = call real eBay + price vendor (requires the keys below)
GRAILBOT_MODE=mock

# ---- eBay Browse API (active listings) -------------------------------------
# Create at https://developer.ebay.com/  → create a keyset (Production).
# GrailBot only needs the public Browse API (client-credentials OAuth).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US          # EBAY_US, EBAY_GB, EBAY_DE, EBAY_ES ...

# ---- Sold-comp price vendor ------------------------------------------------
# The one hard dependency. Pick one; sportscardspro is the cheapest start.
# sportscardspro -> https://www.sportscardspro.com/api-documentation
# cardhedge       -> https://ai.cardhedger.com/api-services
# mock            -> bundled sample comps (default)
PRICE_VENDOR=mock
PRICE_VENDOR_API_KEY=

# ---- Economics (used by the edge model) ------------------------------------
EBAY_FEE_RATE=0.1325              # ~13.25% final value fee
DEFAULT_SHIP_OUT=5.00             # your cost to ship a resale
MIN_NET_EDGE=15.00               # ignore opportunities below this $ profit
MIN_IDENTITY_CONFIDENCE=0.70      # never recommend a card resolved below this
VALUE_FLOOR=8.00                  # skip cards whose comp is below this (fees eat it)

# ---- Storage ---------------------------------------------------------------
# Local SQLite by default (zero setup). Supabase is an optional later phase,
# and MUST be a brand-new dedicated project — never Ganymede or anything else.
DB_PATH=grailbot.db
# SUPABASE_URL=
# SUPABASE_KEY=
